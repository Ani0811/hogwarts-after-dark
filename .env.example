# Hogwarts After Dark — Environment Configuration Example
# Copy this file to .env and adjust for your environment.
# Do NOT commit .env to version control.

# === Companion Service ===

# Host and port the companion binds to (do NOT change to 0.0.0.0)
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765

# Allowed frontend origins (comma-separated)
# Include your local dev server and the published frontend URL
COMPANION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session pairing token is generated at startup — do not set here
# It will be displayed in the terminal when the companion starts

# === LM Studio / AI Provider ===

# LM Studio API endpoint (default: local only)
AI_PROVIDER_BASE_URL=http://127.0.0.1:1234/v1

# Inference timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS=60

# Maximum retries on invalid model response (not connection errors)
AI_MAX_RETRIES=2

# Maximum tokens in model response
AI_MAX_OUTPUT_TOKENS=1024

# Maximum characters in player message
AI_MAX_INPUT_CHARS=4096

# === Game Engine ===

# Path to game data directory (relative to companion root)
GAME_DATA_PATH=../../game-data

# Path to saves directory (relative to companion root)
SAVES_PATH=./saves

# === Logging ===

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to true to enable structured JSON logging
LOG_JSON=false

# === Security ===

# Request body size limit in bytes (default 64 KB)
MAX_REQUEST_BODY_BYTES=65536

# Rate limit: requests per minute per session
RATE_LIMIT_PER_MINUTE=30

